generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Modelos para la autenticación y usuarios
///   Incluye:
///   - User: Usuario del sistema
///   - Session: Sesión del usuario
///   - Role: Rol del usuario
///   - Resource: Recurso del sistema
///   - Action: Acción del sistema
///   - Company: Compañía del sistema
///   - CompanyBranding: Configuración visual de la compañía
///   - UserCompany: Relación entre usuario y compañía
///   - RolePermission: Relación entre rol, acción y subrecurso
///   - Subresource: Subrecurso del sistema
///   - Application: Aplicación del sistema
///   - ApplicationResource: Relación entre aplicación y recurso
///   - CompanyApplication: Relación entre compañía y aplicación
model User {
  id             String        @id @default(uuid()) @db.Uuid
  name           String
  email          String        @unique
  hashedPassword String
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  sessions       Session[]
  companies      UserCompany[]

  @@index([email])
  @@map("users")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  token            String    @unique
  refreshToken     String?
  expiresAt        DateTime
  refreshExpiresAt DateTime?
  device           String?
  ipAddress        String?
  lastActive       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false) // Añadir temporalmente
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   String?          @db.Uuid
  updatedBy   String?          @db.Uuid
  permissions RolePermission[]
  users       UserCompany[]

  @@index([name])
  @@map("roles")
}

model Resource {
  id            String        @id @default(uuid()) @db.Uuid
  name          String        @unique
  icon          String
  path          String        @unique
  applicationId String        @db.Uuid
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdBy     String?       @db.Uuid
  updatedBy     String?       @db.Uuid
  application   Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  subresources  Subresource[]

  @@index([name])
  @@index([applicationId])
  @@map("resources")
}

model Action {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  level       Int
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   String?          @db.Uuid
  updatedBy   String?          @db.Uuid
  permissions RolePermission[]

  @@index([name])
  @@map("actions")
}

model Company {
  id           String               @id @default(uuid()) @db.Uuid
  name         String               @unique
  shortName    String               @unique
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  createdBy    String?              @db.Uuid
  updatedBy    String?              @db.Uuid
  applications CompanyApplication[]
  branding     CompanyBranding?
  users        UserCompany[]
  suppliers    CompanySupplier[]
  receptions   Reception[]

  @@index([name])
  @@map("companies")
}

model CompanyBranding {
  companyId      String   @id @db.Uuid
  logo           String?
  primaryColor   String?  @db.VarChar(25)
  secondaryColor String?  @db.VarChar(25)
  tertiaryColor  String?  @db.VarChar(25)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?  @db.Uuid
  updatedBy      String?  @db.Uuid
  company        Company  @relation(fields: [companyId], references: [id])

  @@map("company_brandings")
}

model UserCompany {
  userId    String   @db.Uuid
  companyId String   @db.Uuid
  roleId    String   @db.Uuid
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, companyId, roleId])
  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
  @@map("user_companies")
}

model RolePermission {
  roleId        String      @db.Uuid
  actionId      String      @db.Uuid
  subresourceId String      @db.Uuid
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  createdBy     String?     @db.Uuid
  updatedBy     String?     @db.Uuid
  action        Action      @relation(fields: [actionId], references: [id], onDelete: Cascade)
  role          Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  subresource   Subresource @relation(fields: [subresourceId], references: [id], onDelete: Cascade)

  @@id([roleId, actionId, subresourceId])
  @@unique([roleId, subresourceId])
  @@index([roleId])
  @@index([subresourceId])
  @@map("role_permissions")
}

model Subresource {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  resourceId      String           @db.Uuid
  icon            String
  path            String           @unique
  controller      String           @unique
  updatedAt       DateTime         @updatedAt
  createdAt       DateTime         @default(now())
  createdBy       String?          @db.Uuid
  updatedBy       String?          @db.Uuid
  rolePermissions RolePermission[]
  resource        Resource         @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([name, resourceId])
  @@index([resourceId])
  @@map("subresources")
}

model Application {
  id          String               @id @default(uuid()) @db.Uuid
  name        String               @unique
  description String?
  path        String               @unique
  logo        String?
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  createdBy   String?              @db.Uuid
  updatedBy   String?              @db.Uuid
  resources   Resource[]
  companies   CompanyApplication[]

  @@index([name])
  @@map("applications")
}

model CompanyApplication {
  companyId     String      @db.Uuid
  applicationId String      @db.Uuid
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  createdBy     String?     @db.Uuid
  updatedBy     String?     @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, applicationId])
  @@unique([companyId, applicationId])
  @@index([companyId])
  @@index([applicationId])
  @@map("company_applications")
}

model DocumentType {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique
  code     String  @unique
  isActive Boolean @default(true)

  suppliers Supplier[]

  @@index([code])
  @@map("document_types")
}

model Supplier {
  id                String            @id @default(uuid()) @db.Uuid
  name              String
  shortName         String            @unique
  documentTypeId    String            @db.Uuid
  documentNumber    String
  verificationDigit String
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdBy         String?           @db.Uuid
  updatedBy         String?           @db.Uuid
  companies         CompanySupplier[]
  receptions        Reception[]

  documentType         DocumentType          @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  supplierMiningTitles SupplierMiningTitle[]

  @@unique([documentNumber])
  @@unique([documentNumber, name])
  @@index([documentNumber])
  @@index([name])
  @@map("suppliers")
}

model CompanySupplier {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @db.Uuid
  supplierId String   @db.Uuid
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String?  @db.Uuid
  updatedBy  String?  @db.Uuid
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([supplierId])
  @@map("company_suppliers")
}

model MeasurementUnit {
  id        String @id @default(uuid()) @db.Uuid
  name      String @unique
  shortName String @unique

  isActive Boolean @default(true)

  @@map("measurement_units")
}

// Tipos de recepción: Dore, Muestras, Mineral, Concentrado.
model ReceptionType {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  receptions          Reception[]
  validOrigins        ReceptionTypeOrigin[]
  validSubSampleTypes ReceptionTypeSubSampleType[]

  @@map("reception_types")
}

// Origen de la recepción: Cabeza, Cola, Secado, Aluvial, Joyería, Subsistencia, etc.
model ReceptionOrigin {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  shortName   String  @unique
  description String?
  isActive    Boolean @default(true)

  receptions Reception[]
  validTypes ReceptionTypeOrigin[]
  Sample     Sample[]

  @@map("reception_origins")
}

// Relación entre tipos de recepción y orígenes válidos
model ReceptionTypeOrigin {
  receptionTypeId   String   @db.Uuid
  receptionOriginId String   @db.Uuid
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String?  @db.Uuid
  updatedBy         String?  @db.Uuid

  receptionType   ReceptionType   @relation(fields: [receptionTypeId], references: [id], onDelete: Cascade)
  receptionOrigin ReceptionOrigin @relation(fields: [receptionOriginId], references: [id], onDelete: Cascade)

  @@id([receptionTypeId, receptionOriginId])
  @@index([receptionTypeId])
  @@index([receptionOriginId])
  @@map("reception_type_origins")
}

// Modelo para encabezado de recepción
model Reception {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @db.Uuid
  supplierId        String   @db.Uuid
  receptionTypeId   String   @db.Uuid
  receptionOriginId String   @db.Uuid
  receptionDate     DateTime
  batchNumber       String?
  observation       String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String?  @db.Uuid
  updatedBy         String?  @db.Uuid

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier        Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  receptionType   ReceptionType   @relation(fields: [receptionTypeId], references: [id])
  receptionOrigin ReceptionOrigin @relation(fields: [receptionOriginId], references: [id])
  Samples         Sample[]

  @@index([companyId])
  @@index([supplierId])
  @@index([receptionTypeId])
  @@index([receptionOriginId])
  @@map("receptions")
}

// Modelo para detalle de recepción (cada dore y cada muestra)
model Sample {
  id                String  @id @default(uuid()) @db.Uuid
  receptionId       String  @db.Uuid
  receptionOriginId String  @db.Uuid
  recievedWeight    Decimal
  dryWeight         Decimal

  reception       Reception       @relation(fields: [receptionId], references: [id], onDelete: Cascade)
  receptionOrigin ReceptionOrigin @relation(fields: [receptionOriginId], references: [id])

  subSamples SubSample[]
  barrenado  Barrenado[]

  @@index([receptionId])
  @@index([receptionOriginId])
  @@map("samples")
}

model Dore {
  id             String  @id @default(uuid()) @db.Uuid
  code           Int     @unique
  recievedWeight Decimal @default(0) @db.Decimal(10, 4)
  finalWeight    Decimal @default(0) @db.Decimal(10, 4)
  goldLaw        Decimal @default(0) @db.Decimal(10, 4)
  goldWeight     Decimal @default(0) @db.Decimal(10, 4)
  silverLaw      Decimal @default(0) @db.Decimal(10, 4)
  silverWeight   Decimal @default(0) @db.Decimal(10, 4)
  goldBalance    Decimal @default(0) @db.Decimal(10, 4)
  silverBalance  Decimal @default(0) @db.Decimal(10, 4)
  approvedLaw    Boolean @default(false)
  observation    String?
  statusId       String  @db.Uuid

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid

  @@index([code])
  @@map("dore")
}

// Relación entre tipos de recepción y tipos de submuestra válidos
model ReceptionTypeSubSampleType {
  receptionTypeId String   @db.Uuid
  subSampleTypeId String   @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?  @db.Uuid
  updatedBy       String?  @db.Uuid

  receptionType ReceptionType @relation(fields: [receptionTypeId], references: [id], onDelete: Cascade)
  subSampleType SubSampleType @relation(fields: [subSampleTypeId], references: [id], onDelete: Cascade)

  @@id([receptionTypeId, subSampleTypeId])
  @@index([receptionTypeId])
  @@index([subSampleTypeId])
  @@map("reception_type_sub_sample_types")
}

// Tipos de submuestra: MPL, MPR, MPA, Barrenado.
model SubSampleType {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?  @db.Uuid
  updatedBy   String?  @db.Uuid

  subSamples SubSample[]
  validTypes ReceptionTypeSubSampleType[]

  @@index([name])
  @@map("sub_sample_types")
}

model SubSample {
  id            String        @id @default(uuid()) @db.Uuid
  SampleId      String        @db.Uuid
  subSampleType SubSampleType @relation(fields: [subSampleTypeId], references: [id])
  weight        Decimal
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdBy     String?       @db.Uuid
  updatedBy     String?       @db.Uuid

  Sample          Sample     @relation(fields: [SampleId], references: [id], onDelete: Cascade)
  analyses        Analysis[]
  subSampleTypeId String     @db.Uuid

  @@index([SampleId])
  @@map("sub_samples")
}

model Barrenado {
  id            String   @id @default(uuid()) @db.Uuid
  SampleId      String   @db.Uuid
  totalWeight   Decimal
  balanceWeight Decimal
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String?  @db.Uuid
  updatedBy     String?  @db.Uuid

  Sample Sample @relation(fields: [SampleId], references: [id], onDelete: Cascade)

  @@index([SampleId])
  @@map("barrenados")
}

// Tipos de análisis: Absorción atómica, XRF (Niton), Copelación, etc.
model AnalysisType {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  shortName   String  @unique
  description String?
  isActive    Boolean @default(true)

  analyses Analysis[]

  @@index([name])
  @@index([shortName])
  @@map("analysis_types")
}

// Tabla para registrar los resultados 
model Analysis {
  id             String   @id @default(uuid()) @db.Uuid
  analysisTypeId String   @db.Uuid
  subSampleId    String   @db.Uuid
  resultValue    Json
  analysisDate   DateTime
  analysisResult Json
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?  @db.Uuid
  updatedBy      String?  @db.Uuid

  analysisType AnalysisType @relation(fields: [analysisTypeId], references: [id], onDelete: Cascade)
  subSample    SubSample    @relation(fields: [subSampleId], references: [id], onDelete: Cascade)

  @@index([analysisTypeId])
  @@index([subSampleId])
  @@map("analyses")
}

model Country {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  isActive    Boolean      @default(true)
  departments Department[]

  @@index([name])
  @@map("countries")
}

model Department {
  id        String  @id @default(uuid()) @db.Uuid
  name      String  @unique
  daneCode  String  @unique
  isActive  Boolean @default(true)
  countryId String  @db.Uuid

  cities  City[]
  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@index([name])
  @@map("departments")
}

model City {
  id           String  @id @default(uuid()) @db.Uuid
  name         String
  daneCode     String
  isActive     Boolean @default(true)
  departmentId String  @db.Uuid

  department           Department            @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  supplierMiningTitles SupplierMiningTitle[]

  @@unique([name, daneCode, departmentId])
  @@index([name])
  @@map("cities")
}

model mineType {
  id                String  @id @default(uuid()) @db.Uuid
  name              String  @unique
  royaltyPercentage Decimal @db.Decimal(7, 4)
  isActive          Boolean @default(true)

  supplierMiningTitles SupplierMiningTitle[]

  @@index([name])
  @@map("mine_types")
}

model SupplierMiningTitle {
  id         String @id @default(uuid()) @db.Uuid
  name       String @unique
  supplierId String @db.Uuid
  mineTypeId String @db.Uuid
  cityId     String @db.Uuid

  isActive Boolean @default(true)

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  city     City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  mineType mineType @relation(fields: [mineTypeId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([mineTypeId])
  @@map("supplier_mining_titles")
}
