generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["debian-openssl-3.0.x"]
  engineType    = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Modelos para la autenticación y usuarios
/// Incluye:
/// - User: Usuario del sistema
/// - Session: Sesión del usuario
/// - Role: Rol del usuario
/// - Resource: Recurso del sistema
/// - Action: Acción del sistema
/// - Company: Compañía del sistema
/// - CompanyBranding: Configuración visual de la compañía
/// - UserCompany: Relación entre usuario y compañía
/// - RolePermission: Relación entre rol, acción y subrecurso
/// - Subresource: Subrecurso del sistema
/// - Application: Aplicación del sistema
/// - ApplicationResource: Relación entre aplicación y recurso
/// - CompanyApplication: Relación entre compañía y aplicación
model User {
  id             String        @id @default(uuid()) @db.Uuid
  name           String
  email          String        @unique
  hashedPassword String
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  sessions       Session[]
  companies      UserCompany[]

  @@index([email])
  @@map("users")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  token            String    @unique
  refreshToken     String?
  expiresAt        DateTime
  refreshExpiresAt DateTime?
  device           String?
  ipAddress        String?
  lastActive       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   String?          @db.Uuid
  updatedBy   String?          @db.Uuid
  isSystem    Boolean          @default(false)
  permissions RolePermission[]
  users       UserCompany[]

  @@index([name])
  @@map("roles")
}

model Resource {
  id            String        @id @default(uuid()) @db.Uuid
  name          String        @unique
  icon          String
  path          String        @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdBy     String?       @db.Uuid
  updatedBy     String?       @db.Uuid
  applicationId String        @db.Uuid
  application   Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  subresources  Subresource[]

  @@index([name])
  @@index([applicationId])
  @@map("resources")
}

model Action {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  level       Int
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   String?          @db.Uuid
  updatedBy   String?          @db.Uuid
  permissions RolePermission[]

  @@index([name])
  @@map("actions")
}

model Company {
  id           String               @id @default(uuid()) @db.Uuid
  name         String               @unique
  shortName    String               @unique
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  createdBy    String?              @db.Uuid
  updatedBy    String?              @db.Uuid


  applications CompanyApplication[]
  branding     CompanyBranding?
  suppliers    CompanySupplier[]
  receptions   Reception[]
  users        UserCompany[]
  Printer      Printer[]

  @@index([name])
  @@map("companies")
}

model CompanyBranding {
  companyId      String   @id @db.Uuid
  logo           String?
  primaryColor   String?  @db.VarChar(25)
  secondaryColor String?  @db.VarChar(25)
  tertiaryColor  String?  @db.VarChar(25)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?  @db.Uuid
  updatedBy      String?  @db.Uuid
  company        Company  @relation(fields: [companyId], references: [id])

  @@map("company_brandings")
}

model UserCompany {
  userId    String   @db.Uuid
  companyId String   @db.Uuid
  roleId    String   @db.Uuid
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, companyId, roleId])
  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
  @@map("user_companies")
}

model RolePermission {
  roleId        String      @db.Uuid
  actionId      String      @db.Uuid
  subresourceId String      @db.Uuid
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  createdBy     String?     @db.Uuid
  updatedBy     String?     @db.Uuid
  action        Action      @relation(fields: [actionId], references: [id], onDelete: Cascade)
  role          Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  subresource   Subresource @relation(fields: [subresourceId], references: [id], onDelete: Cascade)

  @@id([roleId, actionId, subresourceId])
  @@unique([roleId, subresourceId])
  @@index([roleId])
  @@index([subresourceId])
  @@map("role_permissions")
}

model Subresource {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  resourceId      String           @db.Uuid
  icon            String
  path            String           @unique
  updatedAt       DateTime         @updatedAt
  createdAt       DateTime         @default(now())
  createdBy       String?          @db.Uuid
  updatedBy       String?          @db.Uuid
  controller      String           @unique
  rolePermissions RolePermission[]
  resource        Resource         @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([name, resourceId])
  @@index([resourceId])
  @@map("subresources")
}

model Application {
  id          String               @id @default(uuid()) @db.Uuid
  name        String               @unique
  description String?
  path        String               @unique
  logo        String?
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  createdBy   String?              @db.Uuid
  updatedBy   String?              @db.Uuid
  companies   CompanyApplication[]
  resources   Resource[]

  @@index([name])
  @@map("applications")
}

model CompanyApplication {
  companyId     String      @db.Uuid
  applicationId String      @db.Uuid
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  createdBy     String?     @db.Uuid
  updatedBy     String?     @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, applicationId])
  @@unique([companyId, applicationId])
  @@index([companyId])
  @@index([applicationId])
  @@map("company_applications")
}

model DocumentType {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  code      String     @unique
  isActive  Boolean    @default(true)
  suppliers Supplier[]

  @@index([code])
  @@map("document_types")
}

model Supplier {
  id                String   @id @default(uuid()) @db.Uuid
  name              String
  documentNumber    String   @unique
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String?  @db.Uuid
  updatedBy         String?  @db.Uuid
  documentTypeId    String   @db.Uuid
  verificationDigit Int?
  shortName         String   @unique @db.Char(6)

  companies            CompanySupplier[]
  receptions           Reception[]
  supplierMiningTitles SupplierMiningTitle[]
  documentType         DocumentType              @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  supplierOrigins      SupplierReceptionOrigin[]

  @@unique([documentNumber, name])
  @@index([documentNumber])
  @@index([name])
  @@map("suppliers")
}

model CompanySupplier {
  companyId  String   @db.Uuid
  supplierId String   @db.Uuid
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String?  @db.Uuid
  updatedBy  String?  @db.Uuid
  id         String   @id @default(uuid()) @db.Uuid
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([supplierId])
  @@map("company_suppliers")
}

model MeasurementUnit {
  id        String  @id @default(uuid()) @db.Uuid
  name      String  @unique
  shortName String  @unique
  isActive  Boolean @default(true)

  @@map("measurement_units")
}

model ReceptionType {
  id           String                @id @default(uuid()) @db.Uuid
  name         String                @unique
  description  String?
  isActive     Boolean               @default(true)
  validOrigins ReceptionTypeOrigin[]
  receptions   Reception[]

  @@map("reception_types")
}

model ReceptionOrigin {
  id             String  @id @default(uuid()) @db.Uuid
  name           String  @unique
  description    String?
  hasMiningTitle Boolean @default(false)
  isActive       Boolean @default(true)
  shortName      String  @unique

  validTypes           ReceptionTypeOrigin[]
  receptions           Reception[]
  Sample               Sample[]
  defaultAnalysisTypes DefaultAnalysisTypeOrigin[]
  suppliers            SupplierReceptionOrigin[]

  @@map("reception_origins")
}

model ReceptionTypeOrigin {
  receptionTypeId   String          @db.Uuid
  receptionOriginId String          @db.Uuid
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  createdBy         String?         @db.Uuid
  updatedBy         String?         @db.Uuid
  receptionOrigin   ReceptionOrigin @relation(fields: [receptionOriginId], references: [id], onDelete: Cascade)
  receptionType     ReceptionType   @relation(fields: [receptionTypeId], references: [id], onDelete: Cascade)

  @@id([receptionTypeId, receptionOriginId])
  @@index([receptionTypeId])
  @@index([receptionOriginId])
  @@map("reception_type_origins")
}

model Reception {
  id                String               @id @default(uuid()) @db.Uuid
  companyId         String               @db.Uuid
  supplierId        String               @db.Uuid
  receptionDate     DateTime
  batchNumber       String?
  observation       String?
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  createdBy         String?              @db.Uuid
  updatedBy         String?              @db.Uuid
  receptionOriginId String               @db.Uuid
  receptionTypeId   String               @db.Uuid
  miningTitleId     String?              @db.Uuid
  cityId            String?              @db.Uuid
  company           Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  receptionOrigin   ReceptionOrigin      @relation(fields: [receptionOriginId], references: [id])
  receptionType     ReceptionType        @relation(fields: [receptionTypeId], references: [id])
  supplier          Supplier             @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  miningTitle       SupplierMiningTitle? @relation(fields: [miningTitleId], references: [id])
  city              City?                @relation(fields: [cityId], references: [id])
  samples           Sample[]
  dore              Dore[]

  @@index([companyId])
  @@index([supplierId])
  @@index([receptionTypeId])
  @@index([receptionOriginId])
  @@index([miningTitleId])
  @@index([cityId])
  @@map("receptions")
}

model Sample {
  id                String   @id @default(uuid()) @db.Uuid
  receptionId       String   @db.Uuid
  receptionOriginId String   @db.Uuid
  receivedWeight    Decimal
  code              Int      @unique
  statusId          String   @db.Uuid
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String?  @db.Uuid
  updatedBy         String?  @db.Uuid

  reception        Reception                @relation(fields: [receptionId], references: [id], onDelete: Cascade)
  receptionOrigin  ReceptionOrigin          @relation(fields: [receptionOriginId], references: [id])
  status           Status                   @relation(fields: [statusId], references: [id])
  subSamples       SubSample[]
  requiredAnalyses SampleRequiredAnalysis[]
  traces           SamplePrinterTrace[]
  Analysis         Analysis[]

  @@index([receptionId])
  @@index([receptionOriginId])
  @@index([statusId])
  @@map("samples")
}

model SampleRequiredAnalysis {
  id             String       @id @default(uuid()) @db.Uuid
  sampleId       String       @db.Uuid
  analysisTypeId String       @db.Uuid
  done           Boolean      @default(false)
  sample         Sample       @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  analysisType   AnalysisType @relation(fields: [analysisTypeId], references: [id], onDelete: Cascade)
}

model Dore {
  receptionId    String   @db.Uuid
  id             String   @id @default(uuid()) @db.Uuid
  code           Int      @unique @default(autoincrement())
  receivedWeight Decimal  @default(0) @db.Decimal(10, 4)
  finalWeight    Decimal  @default(0) @db.Decimal(10, 4)
  goldLaw        Decimal  @default(0) @db.Decimal(10, 4)
  goldWeight     Decimal  @default(0) @db.Decimal(10, 4)
  silverLaw      Decimal  @default(0) @db.Decimal(10, 4)
  silverWeight   Decimal  @default(0) @db.Decimal(10, 4)
  goldBalance    Decimal  @default(0) @db.Decimal(10, 4)
  silverBalance  Decimal  @default(0) @db.Decimal(10, 4)
  approvedLaw    Boolean  @default(false)
  observation    String?
  base64         String
  format         String
  statusId       String   @db.Uuid
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?  @db.Uuid
  updatedBy      String?  @db.Uuid
  status         Status   @relation(fields: [statusId], references: [id])

  reception Reception @relation(fields: [receptionId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([statusId])
  @@map("dore")
}

model Status {
  id       String   @id @default(uuid()) @db.Uuid
  name     String   @unique
  isActive Boolean  @default(true)
  dores    Dore[]
  samples  Sample[]

  @@map("status")
}

model SubSampleType {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @unique
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  createdBy   String?     @db.Uuid
  updatedBy   String?     @db.Uuid
  subSamples  SubSample[]

  @@index([name])
  @@map("sub_sample_types")
}

model SubSample {
  id              String        @id @default(uuid()) @db.Uuid
  SampleId        String        @db.Uuid
  weight          Decimal
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdBy       String?       @db.Uuid
  updatedBy       String?       @db.Uuid
  subSampleTypeId String        @db.Uuid
  Sample          Sample        @relation(fields: [SampleId], references: [id], onDelete: Cascade)
  subSampleType   SubSampleType @relation(fields: [subSampleTypeId], references: [id])

  @@index([SampleId])
  @@map("sub_samples")
}

model AnalysisType {
  id                String                      @id @default(uuid()) @db.Uuid
  name              String                      @unique
  description       String?
  isActive          Boolean                     @default(true)
  shortName         String                      @unique
  analysisResult    Json
  analyses          Analysis[]
  requiredIn        SampleRequiredAnalysis[]
  defaultForOrigins DefaultAnalysisTypeOrigin[]

  @@index([name])
  @@index([shortName])
  @@map("analysis_types")
}

model Analysis {
  id             String       @id @default(uuid()) @db.Uuid
  analysisTypeId String       @db.Uuid
  sampleId       String       @db.Uuid
  resultValue    Json
  analysisDate   DateTime
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      String?      @db.Uuid
  updatedBy      String?      @db.Uuid
  
  analysisType   AnalysisType @relation(fields: [analysisTypeId], references: [id], onDelete: Cascade)
  sample         Sample       @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  @@index([sampleId])
  @@index([sampleId, analysisTypeId])
  @@map("analyses")
}

model Country {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  isActive    Boolean      @default(true)
  departments Department[]

  @@index([name])
  @@map("countries")
}

model Department {
  id        String  @id @default(uuid()) @db.Uuid
  name      String  @unique
  daneCode  String  @unique
  isActive  Boolean @default(true)
  countryId String  @db.Uuid
  cities    City[]
  country   Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@index([name])
  @@map("departments")
}

model City {
  id                   String                @id @default(uuid()) @db.Uuid
  name                 String
  daneCode             String
  isActive             Boolean               @default(true)
  departmentId         String                @db.Uuid
  department           Department            @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  supplierMiningTitles SupplierMiningTitle[]
  receptions           Reception[]

  @@unique([name, daneCode, departmentId])
  @@index([name])
  @@map("cities")
}

model MineType {
  id                   String                @id @default(uuid()) @db.Uuid
  name                 String                @unique
  royaltyPercentage    Decimal               @db.Decimal(7, 4)
  isActive             Boolean               @default(true)
  supplierMiningTitles SupplierMiningTitle[]

  @@index([name])
  @@map("mine_types")
}

model SupplierMiningTitle {
  id         String      @id @default(uuid()) @db.Uuid
  name       String      @unique
  supplierId String      @db.Uuid
  mineTypeId String      @db.Uuid
  cityId     String      @db.Uuid
  isActive   Boolean     @default(true)
  city       City        @relation(fields: [cityId], references: [id], onDelete: Cascade)
  mineType   MineType    @relation(fields: [mineTypeId], references: [id], onDelete: Cascade)
  supplier   Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  receptions Reception[]

  @@index([supplierId])
  @@index([mineTypeId])
  @@map("supplier_mining_titles")
}

model DefaultAnalysisTypeOrigin {
  receptionOriginId String          @db.Uuid
  analysisTypeId    String          @db.Uuid
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  createdBy         String?         @db.Uuid
  updatedBy         String?         @db.Uuid
  receptionOrigin   ReceptionOrigin @relation(fields: [receptionOriginId], references: [id], onDelete: Cascade)
  analysisType      AnalysisType    @relation(fields: [analysisTypeId], references: [id], onDelete: Cascade)

  @@id([receptionOriginId, analysisTypeId])
  @@index([receptionOriginId])
  @@index([analysisTypeId])
  @@map("default_analysis_type_origins")
}

model SupplierReceptionOrigin {
  id         String @id @default(uuid()) @db.Uuid
  supplierId String @db.Uuid
  originId   String @db.Uuid

  supplier Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  origin   ReceptionOrigin @relation(fields: [originId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([originId])
  @@map("supplier_reception_origins")
}

model Printer {
  id          String               @id @default(uuid()) @db.Uuid
  companyId   String               @db.Uuid
  ip          String
  port        String
  location    String
  printerName String
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  createdBy   String?              @db.Uuid
  updatedBy   String?              @db.Uuid
  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  traces      SamplePrinterTrace[]

  @@unique([companyId, ip])
  @@index([companyId])
  @@map("printers")
}

model SamplePrinterTrace {
  id        String   @id @default(uuid()) @db.Uuid
  sampleId  String   @db.Uuid
  printerId String   @db.Uuid
  count     Int
  createdAt DateTime @default(now())
  sample    Sample   @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  printer   Printer  @relation(fields: [printerId], references: [id], onDelete: Cascade)

  @@index([sampleId])
  @@map("sample_printer_traces")
}
