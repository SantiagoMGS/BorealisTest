generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String   @unique
  password  String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  activeSessions Session[]

  // Campos nuevos para refresh token
  refreshToken       String? // Para almacenar el token de refresco
  refreshTokenExpired DateTime? // Para almacenar la fecha de expiración del token

  companies UserCompany[]
}
// Nuevo modelo para manejar sesiones
model Session {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  token         String   @unique
  device        String?  // Información del dispositivo
  lastActive    DateTime @default(now())
  createdAt     DateTime @default(now())
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model Role {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions RolePermission[] // Relación con permisos
  users       UserCompany[] // Relación con usuarios
}

model Resource {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subresorces Subresource[]
}

model Action {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  level     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions RolePermission[]
}

model Company {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @unique
  logo           String   @unique
  primaryColor   String
  secondaryColor String
  thirdColor     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users        UserCompany[]
  applications CompanyApplications[]
}

model UserCompany {
  userId    String   @db.Uuid
  companyId String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, companyId, roleId])
}

model RolePermission {
  roleId        String   @db.Uuid
  actionId      String   @db.Uuid
  subresourceId String   @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  role        Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  action      Action      @relation(fields: [actionId], references: [id], onDelete: Cascade)
  subresource Subresource @relation(fields: [subresourceId], references: [id], onDelete: Cascade)

  @@id([roleId, actionId, subresourceId])
}

model Subresource {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  resourceId      String           @db.Uuid
  updatedAt       DateTime         @updatedAt
  createdAt       DateTime         @default(now())
  resource        Resource         @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]

  @@unique([name, resourceId])
}

model Application {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  logo     String   @unique

  companies CompanyApplications[]
}

model CompanyApplications {
  companyId     String   @db.Uuid
  applicationId String   @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@id([companyId, applicationId])
}
