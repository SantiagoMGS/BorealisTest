generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String   @unique
  password  String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  companies UserCompany[]
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  permissions RolePermission[] // Relación con permisos
  users       UserCompany[] // Relación con usuarios
}

model Resource {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  permissions RolePermission[]
}

model Action {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  level     Int
  createdAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  permissions RolePermission[]
}

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  logo      String   @unique
  createdAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users        UserCompany[]
  applications CompanyAplications[]
}

model UserCompany {
  userId    String   @db.Uuid
  companyId String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, companyId, roleId])
}

model RolePermission {
  roleId     String   @db.Uuid
  actionId   String   @db.Uuid
  resourceId String   @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  role     Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  action   Action   @relation(fields: [actionId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([roleId, actionId, resourceId])
}

model Aplications {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean
  createdAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  companies CompanyAplications[]
}

model CompanyAplications {
  companyId     String   @db.Uuid
  applicationId String   @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  aplication Aplications @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@id([companyId, applicationId])
}
