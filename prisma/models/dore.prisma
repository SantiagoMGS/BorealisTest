model Dore {
  receptionId    String   @db.Uuid
  id             String   @id @default(uuid()) @db.Uuid
  code           Int      @unique @default(autoincrement())
  receivedWeight Decimal  @default(0) @db.Decimal(10, 4)
  finalWeight    Decimal  @default(0) @db.Decimal(10, 4)
  goldLaw        Decimal  @default(0) @db.Decimal(10, 4)
  goldWeight     Decimal  @default(0) @db.Decimal(10, 4)
  silverLaw      Decimal  @default(0) @db.Decimal(10, 4)
  silverWeight   Decimal  @default(0) @db.Decimal(10, 4)
  goldBalance    Decimal  @default(0) @db.Decimal(10, 4)
  silverBalance  Decimal  @default(0) @db.Decimal(10, 4)
  approvedLaw    Boolean  @default(false)
  observation    String?
  base64         String?
  format         String
  statusId       String   @db.Uuid
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?  @db.Uuid
  updatedBy      String?  @db.Uuid
  status         Status   @relation(fields: [statusId], references: [id])

  reception Reception @relation(fields: [receptionId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([statusId])
  @@map("dore")
}