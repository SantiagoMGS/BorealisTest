model Supplier {
  id                String   @id @default(uuid()) @db.Uuid
  name              String
  documentNumber    String   @unique
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String?  @db.Uuid
  updatedBy         String?  @db.Uuid
  documentTypeId    String   @db.Uuid
  verificationDigit Int?
  shortName         String   @unique @db.Char(6)

  companies            CompanySupplier[]
  receptions           Reception[]
  supplierMiningTitles SupplierMiningTitle[]
  documentType         DocumentType              @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  supplierOrigins      SupplierReceptionOrigin[]

  @@unique([documentNumber, name])
  @@index([documentNumber])
  @@index([name])
  @@map("suppliers")
}

model SupplierMiningTitle {
  id         String      @id @default(uuid()) @db.Uuid
  name       String      @unique
  supplierId String      @db.Uuid
  mineTypeId String      @db.Uuid
  cityId     String      @db.Uuid
  isActive   Boolean     @default(true)
  city       City        @relation(fields: [cityId], references: [id], onDelete: Cascade)
  mineType   MineType    @relation(fields: [mineTypeId], references: [id], onDelete: Cascade)
  supplier   Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  receptions Reception[]

  @@index([supplierId])
  @@index([mineTypeId])
  @@map("supplier_mining_titles")
}

model SupplierReceptionOrigin {
  id         String @id @default(uuid()) @db.Uuid
  supplierId String @db.Uuid
  originId   String @db.Uuid

  supplier Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  origin   ReceptionOrigin @relation(fields: [originId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([originId])
  @@map("supplier_reception_origins")
}